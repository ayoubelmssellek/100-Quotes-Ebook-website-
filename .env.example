# Site
NEXT_PUBLIC_SITE_URL=https://www.mindandhearthub.shop

# EmailJS (public frontend keys only — never put the private key here)
# Dashboard: https://dashboard.emailjs.com/
# Template should send to contact@mindandhearthub.shop
# Suggested template variables:
# {{to_email}} {{order_id}} {{product_name}} {{plan}} {{price}} {{order_date}} {{message}}
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
