# Public site URL (no trailing slash) — required for Polar success redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment provider
PAYMENT_PROVIDER=polar

# ─── Polar checkout setup ───────────────────────────────────────────
# 1) Create an Organization Product in Polar for the e-book
# 2) Create an API key (Organization Settings → Developers)
# 3) Create a webhook pointing to:
#      100-quotes-ebook-website.vercel.app
#    Recommended events: order.paid, checkout.updated
# 4) Paste values below (never commit real secrets)

# sandbox | production
POLAR_SERVER=sandbox

# Organization Access Token (API key) — server only
POLAR_ACCESS_TOKEN=

# Polar Product ID for "100 Inspirational Quotes..."
POLAR_PRODUCT_ID=
NEXT_PUBLIC_POLAR_PRODUCT_ID=

# Webhook signing secret from Polar dashboard
POLAR_WEBHOOK_SECRET=

# ─── Optional other providers ───────────────────────────────────────
NEXT_PUBLIC_STRIPE_PRICE_ID=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

NEXT_PUBLIC_PADDLE_PRICE_ID=
PADDLE_API_KEY=
PADDLE_PRICE_ID=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox

CONTACT_WEBHOOK_URL=
