# Site
NEXT_PUBLIC_SITE_URL=https://www.mindandhearthub.shop

# Payment provider
PAYMENT_PROVIDER=whop

# Optional fallback if a product-specific Whop link is empty
NEXT_PUBLIC_CHECKOUT_URL=

# --- Whop checkout links (paste each product’s Whop checkout URL) ---
# Create the product + upload files on Whop, then paste the checkout link here.
# Change anytime in Vercel env vars — no code edit needed.

# E-books
NEXT_PUBLIC_WHOP_CHECKOUT_QUOTES=
NEXT_PUBLIC_WHOP_CHECKOUT_EVERYDAY=

# Kids science stories — singles ($12 each)
NEXT_PUBLIC_WHOP_CHECKOUT_KIDS_01=
NEXT_PUBLIC_WHOP_CHECKOUT_KIDS_02=
NEXT_PUBLIC_WHOP_CHECKOUT_KIDS_03=
NEXT_PUBLIC_WHOP_CHECKOUT_KIDS_04=
NEXT_PUBLIC_WHOP_CHECKOUT_KIDS_05=
NEXT_PUBLIC_WHOP_CHECKOUT_KIDS_06=
NEXT_PUBLIC_WHOP_CHECKOUT_KIDS_07=
NEXT_PUBLIC_WHOP_CHECKOUT_KIDS_08=
NEXT_PUBLIC_WHOP_CHECKOUT_KIDS_09=
NEXT_PUBLIC_WHOP_CHECKOUT_KIDS_10=

# Kids packs — Basic (2 PDFs), Premium (3 PDFs), Pro (Canva links PDF)
NEXT_PUBLIC_WHOP_CHECKOUT_KIDS_BASIC=
NEXT_PUBLIC_WHOP_CHECKOUT_KIDS_PREMIUM=
NEXT_PUBLIC_WHOP_CHECKOUT_KIDS_PRO=
