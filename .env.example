# Public site URL — use the exact domain visitors use (with www if you use www)
NEXT_PUBLIC_SITE_URL=https://www.mindandhearthub.shop

PAYMENT_PROVIDER=polar
POLAR_SERVER=production

POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
NEXT_PUBLIC_POLAR_PRODUCT_ID=
POLAR_WEBHOOK_SECRET=

# ─── Consultation packages (matching duration ladder) ───
# $15 / 1 month → $30 / 3 months → $40 / 6 months → $60 / 12 months
# INTERVAL values: 1_month | 3_months | 6_months | 12_months | one_time
# Update Polar products to the same billing cycle, then Redeploy.

CONSULTATION_ENABLED=true
CONSULTATION_CURRENCY=USD

CONSULTATION_15_ENABLED=true
CONSULTATION_15_NAME=Starter
CONSULTATION_15_PRICE=15
CONSULTATION_15_INTERVAL=1_month
CONSULTATION_15_DESCRIPTION=A focused 1-month check-in to clarify goals and stay accountable.
CONSULTATION_15_FEATURES=1 consultation session|Email support|Personal action plan|Billed every 1 month
CONSULTATION_15_POLAR_PRODUCT_ID=
CONSULTATION_15_FEATURED=false
CONSULTATION_15_CTA=Subscribe

CONSULTATION_30_ENABLED=true
CONSULTATION_30_NAME=Growth
CONSULTATION_30_PRICE=30
CONSULTATION_30_INTERVAL=3_months
CONSULTATION_30_DESCRIPTION=3 months of guidance for habits, mindset, and consistent growth.
CONSULTATION_30_FEATURES=Consultation sessions across 3 months|Priority email support|Custom habit roadmap|Progress review|Billed every 3 months
CONSULTATION_30_POLAR_PRODUCT_ID=
CONSULTATION_30_FEATURED=true
CONSULTATION_30_CTA=Subscribe

CONSULTATION_40_ENABLED=true
CONSULTATION_40_NAME=Momentum
CONSULTATION_40_PRICE=40
CONSULTATION_40_INTERVAL=6_months
CONSULTATION_40_DESCRIPTION=6 months of structured coaching for confidence and discipline.
CONSULTATION_40_FEATURES=Consultation sessions across 6 months|Priority support|Personalized growth plan|Weekly check-in prompts|Billed every 6 months
CONSULTATION_40_POLAR_PRODUCT_ID=
CONSULTATION_40_FEATURED=false
CONSULTATION_40_CTA=Subscribe

CONSULTATION_60_ENABLED=true
CONSULTATION_60_NAME=Premium
CONSULTATION_60_PRICE=60
CONSULTATION_60_INTERVAL=12_months
CONSULTATION_60_DESCRIPTION=12 months of premium support for long-term transformation.
CONSULTATION_60_FEATURES=Consultation sessions across 12 months|Direct priority support|Full personalized strategy|Monthly progress report|Billed every 12 months
CONSULTATION_60_POLAR_PRODUCT_ID=
CONSULTATION_60_FEATURED=false
CONSULTATION_60_CTA=Subscribe
