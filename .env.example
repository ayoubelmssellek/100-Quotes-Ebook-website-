# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment provider: polar | stripe | paddle
PAYMENT_PROVIDER=polar

# Optional public product/price IDs (safe to expose)
NEXT_PUBLIC_POLAR_PRODUCT_ID=
NEXT_PUBLIC_STRIPE_PRICE_ID=
NEXT_PUBLIC_PADDLE_PRICE_ID=

# Polar.sh (server-only — never expose)
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_WEBHOOK_SECRET=

# Stripe (server-only — never expose)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Paddle (server-only — never expose)
PADDLE_API_KEY=
PADDLE_PRICE_ID=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox

# Optional contact webhook / email bridge (server-only)
CONTACT_WEBHOOK_URL=
