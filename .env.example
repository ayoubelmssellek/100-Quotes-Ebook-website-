CONSULTATION_15_FEATURES=1 consultation session / month|Email support|Personal action plan
CONSULTATION_15_POLAR_PRODUCT_ID=
CONSULTATION_15_FEATURED=false
CONSULTATION_15_CTA=Subscribe

# $30 plan (featured by default)
